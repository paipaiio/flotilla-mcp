# syntax=docker/dockerfile:1

# ── build stage: compile the workspace, deploy gateway + engine ──
FROM node:22-slim AS build
WORKDIR /app
RUN corepack enable
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml tsconfig.base.json ./
COPY packages/core/package.json packages/core/
COPY packages/mcp-stdio/package.json packages/mcp-stdio/
COPY packages/gateway/package.json packages/gateway/
RUN pnpm install --frozen-lockfile
COPY packages/core packages/core
COPY packages/mcp-stdio packages/mcp-stdio
COPY packages/gateway packages/gateway
RUN pnpm build
# Standalone prod install of just the gateway (converts workspace:* deps).
RUN pnpm --filter flotilla-gateway deploy --legacy --prod /prod

# ── runtime stage: minimal, non-root ──────────────────────────
FROM node:22-slim
ENV NODE_ENV=production
# ssh-keygen is required at runtime: fleet keypair generation (enroll-join,
# flotilla add --bootstrap) and certauth CA operations all shell out to it.
# node:*-slim does not ship it — without this package a fresh gateway's first
# enrollment dies with "spawnSync ssh-keygen ENOENT".
RUN apt-get update && apt-get install -y --no-install-recommends openssh-client \
  && rm -rf /var/lib/apt/lists/*
ENV FLOTILLA_IN_DOCKER=1
WORKDIR /app
COPY --from=build /prod ./
USER node
EXPOSE 8080
# FLOTILLA_GATEWAY_TOKEN is REQUIRED — the gateway refuses to start without it.
#
#   docker run -d --name flotilla-gateway \
#     -p 8080:8080 \
#     -v ~/.config/flotilla/config.toml:/home/node/.config/flotilla/config.toml:ro \
#     -v ~/.ssh:/home/node/.ssh:ro \
#     -e FLOTILLA_GATEWAY_TOKEN=$(openssl rand -hex 32) \
#     ghcr.io/paipaiio/flotilla-gateway
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:8080/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
ENTRYPOINT ["node", "/app/dist/index.js"]
CMD ["--host", "0.0.0.0", "--port", "8080"]
