{
  "name": "flotilla",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:coverage": "pnpm build && pnpm --filter flotilla-core test:coverage && pnpm --filter flotilla-mcp test:coverage && pnpm --filter flotilla-gateway test:coverage",
    "test:fuzz": "pnpm --filter flotilla-core test:fuzz",
    "test:integration": "pnpm --filter flotilla-mcp test:integration",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^3.2.7",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
