{
  "name": "flotilla-gateway",
  "version": "0.10.4",
  "description": "Flotilla HTTP Gateway: the same fleet engine as flotilla-mcp, exposed over stateless Streamable HTTP MCP with bearer-token auth.",
  "type": "module",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paipaiio/flotilla-mcp.git",
    "directory": "packages/gateway"
  },
  "homepage": "https://github.com/paipaiio/flotilla-mcp",
  "bugs": "https://github.com/paipaiio/flotilla-mcp/issues",
  "bin": {
    "flotilla-gateway": "./dist/index.js"
  },
  "main": "./dist/http-server.js",
  "files": [
    "dist",
    "console"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "gateway",
    "ssh",
    "fleet",
    "devops"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm --filter flotilla-core build && pnpm --filter flotilla-mcp build && vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "flotilla-core": "workspace:*",
    "flotilla-mcp": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.18.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "vitest": "^3.2.4"
  }
}
