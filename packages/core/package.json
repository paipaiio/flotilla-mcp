{
  "name": "@flotilla/core",
  "version": "0.1.0",
  "description": "Flotilla core engine: fleet registry, target expressions, fan-out executor, policy.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepack": "cp ../../LICENSE .",
    "prepublishOnly": "pnpm build && pnpm test"
  },
  "dependencies": {
    "smol-toml": "^1.3.1",
    "ssh2": "^1.16.0",
    "yaml": "^2.9.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/ssh2": "^1.15.4"
  }
}
