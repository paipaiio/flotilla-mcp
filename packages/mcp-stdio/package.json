{
  "name": "flotilla-mcp",
  "version": "1.0.0",
  "description": "多服务器 SSH MCP：让 AI 一次管理所有服务器 —— 批量执行 · 跨机比对 · 策略审批 · 防篡改审计",
  "type": "module",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paipaiio/flotilla-mcp.git",
    "directory": "packages/mcp-stdio"
  },
  "homepage": "https://github.com/paipaiio/flotilla-mcp",
  "bugs": "https://github.com/paipaiio/flotilla-mcp/issues",
  "bin": {
    "flotilla-mcp": "./dist/index.js",
    "flotilla": "./bin/fleet.mjs"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "bin",
    "README_en.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ssh",
    "fleet",
    "devops",
    "multi-server",
    "ai-agent"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm --filter flotilla-core build && pnpm build && vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "pnpm --filter flotilla-core build && pnpm build && vitest run test/tools-integration.test.ts",
    "prepack": "cp ../../README.md ../../README_en.md ../../LICENSE .",
    "prepublishOnly": "pnpm build && pnpm test"
  },
  "dependencies": {
    "flotilla-core": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.18.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "vitest": "^3.2.4"
  }
}
